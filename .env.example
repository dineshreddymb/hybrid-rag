# Copy to .env and fill in. .env is git-ignored and never baked into an image.
#   PowerShell:  Copy-Item .env.example .env
# NOTE: keep comments on their own lines — env files do not support "KEY=value  # comment".

# --- Image Registry & Versioning ---------------------------------------------
# IMAGE_REGISTRY: localhost (local only) or your Docker Hub username (e.g. mbdin)
IMAGE_REGISTRY=localhost
APP_VERSION=v1.0.0
GIT_COMMIT_SHA=dev
BUILD_DATE=local
ENVIRONMENT=development

# --- LLM (Google Gemini) -----------------------------------------------------
# LLM_PROVIDER: gemini | fake  (fake = offline test model, no key needed)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# 0 = no "thinking" tokens (cheaper, faster); -1 = don't send the parameter
LLM_THINKING_BUDGET=0

# --- Embeddings & Reranker (Jina AI / Hugging Face) -----------------------------
# EMBEDDING_PROVIDER: jina | hf_api | fake (offline) | tei (local TEI container)
EMBEDDING_PROVIDER=jina
JINA_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# RERANK_PROVIDER: jina | none
RERANK_PROVIDER=none
RERANK_MODEL=jina-reranker-v2-base-multilingual

# Optional: HF_TOKEN (if using EMBEDDING_PROVIDER=hf_api)
HF_TOKEN=

# --- Chunking / retrieval (approved: 800 / 120) --------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_FINAL=5
# BM25 weight = 1 - HYBRID_WEIGHT_DENSE
HYBRID_WEIGHT_DENSE=0.5
FAST_MODE=true
ENABLE_GRADING=false
ENABLE_GROUNDING_CHECK=false

# --- Backend URL: how the frontend, mcp-server and eval reach the backend ------------
# (from your own PC, e.g. when running eval outside a container, use http://localhost:8000)
BACKEND_URL=http://backend:8000

# --- Stores (only the backend uses these; hostnames on backend-net) -------------------
MONGO_URI=mongodb://mongodb:27017
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks_bge_small_en_v1_5

# --- Redis cache (backend only) -------------------------------------------------------
# REDIS_PASSWORD is generated by: tasks.ps1 setup   (scripts/sync_env.py)
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CACHE_ENABLED=true
# answers 24 h, search results 10 min, embeddings 30 days
CACHE_TTL_ANSWER_S=86400
CACHE_TTL_SEARCH_S=600
CACHE_TTL_EMBEDDING_S=2592000

# --- HTTP protection / backups -------------------------------------------------------
# Both frontend and MCP inherit API_KEY automatically through compose. Keep blank for local-only use.
API_KEY=
MCP_API_KEY=
# Redis-backed per-client limits. Redis outages fail open, so answers remain available.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_ASK_PER_MINUTE=20
# Creates and retains Qdrant snapshots in data/qdrant_snapshots; host-level Mongo backups remain manual.
QDRANT_SNAPSHOT_SCHEDULE_ENABLED=true
QDRANT_SNAPSHOT_INTERVAL_HOURS=24
QDRANT_SNAPSHOT_KEEP=7

# --- Langfuse Tracing (Langfuse Cloud or Self-hosted) ---------------------
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_URL=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0

# --- Evaluation (RAGAS) ---------------------------------------------------------
EVAL_LLM_MODEL=gemini-3.5-flash-lite
EVAL_MAX_WORKERS=2

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TTL_DAYS=30

# --- Cloud Storage Auto-Sync ----------------------------------------------------
DOCS_REMOTE_ZIP_URL=https://eedxymqeghvxjkzfvvbd.supabase.co/storage/v1/object/public/docs/docs.zip
DOCS_SYNC_INTERVAL_SECONDS=300
DOCS_SYNC_ENABLED=true
SUPABASE_URL=https://eedxymqeghvxjkzfvvbd.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=docs


