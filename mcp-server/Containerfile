# ---------- stage 1: build a virtualenv with all dependencies ----------
FROM docker.io/library/python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /build
# Copy only pyproject.toml first: the pip install layer is cached until dependencies change.
COPY pyproject.toml .
RUN python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); open('requirements.txt','w').write('\n'.join(d['project']['dependencies']))" \
 && pip install -r requirements.txt

# ---------- stage 2: small runtime image ----------
FROM docker.io/library/python:3.12-slim
RUN useradd --create-home --uid 10001 app
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MCP_TRANSPORT=http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8100 \
    MCP_PATH=/mcp \
    BACKEND_URL=http://backend:8000
WORKDIR /srv
COPY mcp_server ./mcp_server
# Secrets (API_KEY, MCP_API_KEY) are NOT in the image: pass them at runtime (env_file: .env).
USER app
EXPOSE 8100
# The healthcheck lives in compose.yaml (Podman ignores HEALTHCHECK in OCI-format images).
CMD ["python", "-m", "mcp_server", "--transport", "http"]
