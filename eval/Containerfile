# One-off evaluation job: python -m eval_job.run_eval --mode all
# ---------- stage 1: build a virtualenv with all dependencies ----------
FROM docker.io/library/python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /build
# Dependencies first so this (slow) layer is cached until pyproject.toml changes.
COPY pyproject.toml .
RUN python -c "import tomllib; d=tomllib.load(open('pyproject.toml','rb')); open('requirements.txt','w').write('\n'.join(d['project']['dependencies']))" \
 && pip install -r requirements.txt

# ---------- stage 2: small runtime image ----------
FROM docker.io/library/python:3.12-slim
RUN useradd --create-home --uid 10001 app \
 && mkdir -p /work/eval/reports && chown -R app:app /work
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/eval \
    EVAL_DIR=/work/eval \
    BACKEND_URL=http://backend:8000 \
    RAGAS_DO_NOT_TRACK=true
COPY eval_job /opt/eval/eval_job
# The golden set is mounted at /work/eval (./tests/eval); reports go to /work/eval/reports.
# Secrets (GOOGLE_API_KEY, HF_TOKEN, Langfuse keys) come from env_file at runtime.
WORKDIR /work
USER app
ENTRYPOINT ["python", "-m", "eval_job.run_eval"]
CMD ["--mode", "hybrid"]
