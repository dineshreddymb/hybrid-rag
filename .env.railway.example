# ==============================================================================
# Production Environment Variables for Railway Deployment
# ==============================================================================
# In Railway, you can reference variables from other services using ${{ Service.VAR }}
# ==============================================================================

# --- Application Metadata & Versioning ---
ENVIRONMENT=production
APP_VERSION=1.0.0
SERVICE_NAME=hybrid-rag

# --- LLM & AI Keys ---
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_THINKING_BUDGET=0

# --- Embeddings & Reranker ---
EMBEDDING_PROVIDER=jina
JINA_API_KEY=your_jina_api_key_here
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024
RERANK_PROVIDER=jina
RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Railway Managed Databases (Reference variables from Railway plugins) ---
# If using Railway's Redis plugin:
REDIS_URL=${{ Redis.REDIS_URL }}
CACHE_ENABLED=true

# If using Railway's MongoDB plugin:
MONGO_URI=${{ MongoDB.MONGO_URL }}
MONGO_DB=hybrid_rag

# --- Qdrant Vector DB (Deployed as a Railway Docker service with volume) ---
# When deployed inside the same Railway project, services communicate over private mesh:
QDRANT_URL=http://qdrant.railway.internal:6333
QDRANT_COLLECTION=chunks_jina_v3

# --- Inter-Service Communication on Railway Private Network ---
# For Frontend -> Backend:
BACKEND_URL=http://rag-backend.railway.internal:8000
API_URL=http://rag-backend.railway.internal:8000

# For Backend -> MCP Server:
MCP_SERVER_URL=http://rag-mcp.railway.internal:8100/mcp

# --- Observability (Langfuse Cloud) ---
LANGFUSE_PUBLIC_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Security ---
API_KEY=generate_a_secure_random_token_here
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=240
RATE_LIMIT_ASK_PER_MINUTE=40
